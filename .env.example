# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey . Leave empty until the owner pastes a key.
GEMINI_API_KEY=

# Gemini model tried first. Optional; defaults to gemini-3.5-flash-lite in src/lib/config.ts.
GEMINI_MODEL=gemini-3.5-flash-lite

# Second Gemini model tried before OpenRouter. Optional; defaults to gemini-3.8-flash in src/lib/config.ts.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# OpenRouter API key from https://openrouter.ai/keys . Optional fallback provider; leave empty to disable it.
OPENROUTER_API_KEY=

# OpenRouter model ID from https://openrouter.ai/models . Required only when OPENROUTER_API_KEY is set.
OPENROUTER_MODEL=
